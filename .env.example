# ============================================================
# REDZ KEY SYSTEM - Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).
# ============================================================

# URL do seu projeto Supabase
# Encontrar em: Supabase Dashboard -> Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Chave pública (anon) do Supabase
# Encontrar em: Supabase Dashboard -> Settings -> API -> anon public
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo

# Senha do painel administrativo — ALTERE ISTO para uma senha forte!
# Recomendado: 32+ caracteres, gerado aleatoriamente.
ADMIN_API_KEY=troque-esta-chave-por-uma-senha-forte-e-unica

# Porta do servidor (Render define automaticamente via process.env.PORT,
# mas mantenha este valor como fallback para rodar localmente)
PORT=3000
